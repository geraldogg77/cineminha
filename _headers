# Cloudflare Pages: a página sempre é conferida, então todo mundo pega a versão nova na hora.
# Os outros arquivos já levam a versão no endereço (?v=), então podem ficar guardados.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: public, max-age=604800
/styles.css
  Cache-Control: public, max-age=604800
/download/*
  Cache-Control: no-cache
  Content-Disposition: attachment; filename="CineminhaAudio.exe"
/helper/*
  X-Robots-Tag: noindex
/worker/*
  X-Robots-Tag: noindex
/alive.txt
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache
/sitemap.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
